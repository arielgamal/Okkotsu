{
  "type": "crawler",
  "url": "https://www.in.gov.br/consulta/-/buscar",
  "method": "GET",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
    "Accept-Language": "pt-BR,pt;q=0.9"
  },
  "statusCode": 200,
  "contentType": "query",
  "data": {
    "q": "{{termo}}",
    "exactDate": "{{data}}",
    "delta": "20",
    "orins": "1"
  },
  "samples": {
    "q": "licitação",
    "exactDate": "09/04/2026",
    "delta": "20",
    "orins": "1"
  },
  "id": "dou_busca_exemplo",
  "name": "busca_dou",
  "activated": true,
  "print_selector": "button.print, .btn-imprimir, [title='Imprimir']",
  "output_file": "dou_{{termo}}_{{data}}.pdf"
}
